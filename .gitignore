# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*

# secrets / credentials — never committed (no source filenames match these
# patterns today; verified via find before adding)
*secret*
*token*
*key*

# vercel / build tooling
.vercel
.turbo/
dist/

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
logs/
*.log

# local databases / runtime state
*.sqlite
*.sqlite-*
*.db

# runtime-generated local audit log (project-local persistence, not source)
/data/audit-log.jsonl
/data/approval-decisions.jsonl
/data/agent-conversations.jsonl
/data/claude-code-sessions.json
/data/cli-agent-sessions.json
/data/attachments/

# Claude Code machine-local approvals; project policy lives in .claude/settings.json
/.claude/settings.local.json
